# Copy to .env and fill in. Nothing here is a real secret.

# Flask / JWT — generate real values with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# Postgres (docker-compose default shown)
DATABASE_URL=postgresql+psycopg://nominate:nominate@localhost:5432/nominate
TEST_DATABASE_URL=postgresql+psycopg://nominate:nominate@localhost:5432/nominate_test

# Comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Places (Phase 5)
GOOGLE_PLACES_API_KEY=
