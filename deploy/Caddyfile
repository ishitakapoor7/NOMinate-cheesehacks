# SITE_ADDRESS is your domain (e.g. nominate.duckdns.org). With a real domain,
# Caddy automatically obtains and renews a Let's Encrypt certificate — you get
# HTTPS with zero extra config, which Google OAuth requires. For a local test,
# set SITE_ADDRESS=:80 to serve plain HTTP.
{$SITE_ADDRESS} {
	encode gzip

	# API + auth + health check → the Flask/gunicorn container on the compose network.
	@backend path /api/* /auth/* /health
	handle @backend {
		reverse_proxy api:8000
	}

	# Everything else is the single-page app; unknown paths fall back to index.html.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
