# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.

# ── Your domain ──────────────────────────────────────────────────────────────
# SITE_ADDRESS: the domain Caddy serves + gets an HTTPS cert for (no scheme).
# SITE_URL: the same thing with https:// — baked into the frontend as the API base.
SITE_ADDRESS=nominate.example.com
SITE_URL=https://nominate.example.com

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_USER=nominate
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=nominate

# ── Flask secrets (generate with: python -c "import secrets; print(secrets.token_hex(32))") ──
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me

# ── Same-origin, but set so CORS is happy if anything cross-origin sneaks in ──
CORS_ORIGINS=https://nominate.example.com

# ── Google Sign-In (OAuth) — add SITE_URL to the client's Authorized JS origins ──
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
VITE_GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com

# ── Third-party data APIs ────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=your-places-key
SPOONACULAR_API_KEY=your-spoonacular-key
