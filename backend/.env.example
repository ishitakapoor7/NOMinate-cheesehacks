# Copy to .env and fill in. Never commit the real .env.

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string

# Database (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg://nominate:nominate@localhost:5432/nominate
# Separate database used by the test suite
TEST_DATABASE_URL=postgresql+psycopg://nominate:nominate@localhost:5432/nominate_test

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Google OAuth (Phase 3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Restaurant lookup (Phase 5)
GOOGLE_PLACES_API_KEY=
